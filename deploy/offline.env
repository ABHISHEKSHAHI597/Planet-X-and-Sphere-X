# Offline demo laptop (workflow.md §12.1, §13; implementation.md §9). No network at all: the API serves only
# the RC's snapshot, with the "cached demo data" badge. Used as: docker compose --env-file deploy/offline.env up -d
# The api service also reads .env: on a laptop, copy this file to .env as well.
ENVIRONMENT=snapshot
OFFLINE=1
SNAPSHOT_DIR=/snapshot
SNAPSHOT_HOST_DIR=./snapshot
CALIB_HOST_DIR=./calib
CPU_WORKERS=2
RUN_WATCHER=0
SITE_ADDRESS=:80
IMAGE_TAG=RC1
