# Copy to .env on the VM (never commit .env). Every variable is documented in backend/app/settings.py.
ENVIRONMENT=staging                 # staging | production
FRAMESOURCE=auto                    # auto picks S3 sections in us-east-1 (F12 decides the default)
IN_AWS_US_EAST_1=1
CPU_WORKERS=2
JOB_TIMEOUT_S=300
MAX_FOV_ARCMIN=30
MAX_FRAMES_PER_VIEW=600
JOBS_PER_MINUTE_PER_IP=6
CANDIDATES_PER_HOUR_PER_IP=10
PUBLIC_GALLERY=0
CACHE_MAX_GB=20                     # frames + views; least recently used deleted past it (demo pins kept)
RUN_WATCHER=1
SNAPSHOT_DIR=/snapshot              # used automatically when IRSA health checks fail
CALIB_ROOT_IN_CONTAINER=/calib      # after scripts/bootstrap_calib.py fetch into CALIB_HOST_DIR
CALIB_HOST_DIR=/srv/parallax-data/calib
SNAPSHOT_HOST_DIR=/srv/parallax-data/snapshot
SITE_ADDRESS=staging.example.org    # public host name → automatic HTTPS; ":80" for plain HTTP
REGISTRY=ghcr.io/<org>
IMAGE_TAG=main
